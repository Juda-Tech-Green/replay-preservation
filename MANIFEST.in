include LICENSE README.md CONTRIBUTING.md SECURITY.md CHANGELOG.md ROADMAP.md
include ARCHITECTURE.md CLI_REFERENCE.md WORKFLOW.md PRESERVATION_SCHEMA.md DISC02_PILOT_PLAN.md SKILL.md
include PUBLIC_RELEASE_READINESS.md PUBLIC_FILE_MANIFEST.md PUBLIC_SECURITY_AUDIT.md RELEASE_NOTES_v0.1.0-alpha.md FIRST_PUSH_PLAN.md
include .gitignore public-release-files.json requirements-build.txt
recursive-include src *.py
recursive-include scripts *.py
recursive-include tests *.py *.json
recursive-include schemas *.json
recursive-include templates *.json
recursive-include docs *.md
recursive-include .agents *.md *.yaml
prune evidence
prune images
prune recovery
prune extracted
prune reconstructed
prune catalog
prune emulation
global-exclude *.py[cod] __pycache__ *.iso *.bin *.exe *.wad *.dsg *.sqlite* *.log
